# ============================================================
# H3 Java 환경변수 예시 파일
# 이 파일은 GitHub에 올려도 됩니다 (실제 값 없음)
# 실제 값은 .env.local(로컬) 또는 .env.prod(운영)에 작성하세요
# ============================================================

# Server
H3_SERVER_PORT=8080

# MySQL
H3_MYSQL_URL=jdbc:mysql://HOST:3306/DB_NAME?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
H3_MYSQL_USERNAME=your_mysql_username
H3_MYSQL_PASSWORD=your_mysql_password

# MongoDB
H3_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DB_NAME?retryWrites=true&w=majority&connectTimeoutMS=10000&socketTimeoutMS=30000&serverSelectionTimeoutMS=10000

# RabbitMQ
H3_RABBITMQ_HOST=your_rabbitmq_host
H3_RABBITMQ_PORT=5672
H3_RABBITMQ_USERNAME=your_rabbitmq_username
H3_RABBITMQ_PASSWORD=your_rabbitmq_password
H3_RABBITMQ_VHOST=your_rabbitmq_vhost

# Kakao SA
KAKAO_SA_CLIENT_ID=your_kakao_sa_client_id
KAKAO_SA_CLIENT_SECRET=your_kakao_sa_client_secret

# Kakao MO
KAKAO_MO_CLIENT_ID=your_kakao_mo_client_id
KAKAO_MO_CLIENT_SECRET=your_kakao_mo_client_secret

# Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_DEVELOPER_TOKEN=your_google_developer_token
GOOGLE_MANAGER_ID=your_google_manager_id

# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# JWT
H3_JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long
H3_JWT_EXPIRATION=86400000

# Meta API (추후 연동 시 사용)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_meta_access_token
META_BUSINESS_ID=your_meta_business_id
META_AD_ACCOUNT_ID=act_your_ad_account_id
