<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.h3.h3_java.media.google.mapper.GoogleMapper">

  <!-- ── Accounts ─────────────────────────────────────────────────────────── -->

  <select id="selectGoogleAccounts" resultType="com.h3.h3_java.media.google.dto.GoogleAccountDto">
    SELECT user_id, account_google
    FROM h3_account
    WHERE account_google IS NOT NULL AND account_google != ''
  </select>


</mapper>
